rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /product-videos/{userId}/{fileName} {
      // Product videos are public storefront media; uploads are restricted to the shop admin.
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (
          request.auth.token.email == 'ked160117@gmail.com'
          || request.auth.uid == 'cjUzsc6SK4ZBrsddvFQjuhPphBA2'
        )
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
  }
}