rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'ked160117@gmail.com' ||
        request.auth.uid == 'cjUzsc6SK4ZBrsddvFQjuhPphBA2'
      );
    }

    // Admins collection: Used for Role-Based Access Control (RBAC)
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // Sanitized public mirrors. Only allowlisted display fields are readable by visitors.
    match /publicGames/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicStoneRates/{rateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Canonical game catalog, including candidates and internal fields: admin only.
    match /games/{gameId} {
      allow read, write: if isAdmin();
    }

    // Canonical products, including drafts and unpublished records: admin only.
    match /products/{productId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Canonical stone rates, internal notes, and price history: admin only.
    match /stoneRates/{rateId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Product videos and chunks remain private until a separately reviewed public-video design.
    match /productVideos/{videoId} {
      allow read, create, update, delete: if isAdmin();
      match /chunks/{chunkId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    // Serial Sequence & Permanent Retired Number Registry: Admin only
    match /sequences/{gameCode} {
      allow read, write: if isAdmin();
    }

    // Customer requests: public create only with a bounded, exact field schema.
    // No client may set adminNotes, status, or arbitrary extra/private fields.
    function validPublicRequest(requestId) {
      return request.resource.data.keys().hasAll([
          'id', 'gameTitle', 'requestType', 'desiredQuantity',
          'budget', 'contactNotes', 'createdAt', 'status'
        ]) &&
        request.resource.data.keys().hasOnly([
          'id', 'gameTitle', 'requestType', 'desiredQuantity',
          'budget', 'contactNotes', 'createdAt', 'status'
        ]) &&
        request.resource.data.id == requestId &&
        request.resource.data.id is string &&
        request.resource.data.id.size() <= 80 &&
        request.resource.data.gameTitle is string &&
        request.resource.data.gameTitle.size() > 0 &&
        request.resource.data.gameTitle.size() <= 120 &&
        request.resource.data.requestType is string &&
        request.resource.data.requestType.size() > 0 &&
        request.resource.data.requestType.size() <= 80 &&
        request.resource.data.desiredQuantity is string &&
        request.resource.data.desiredQuantity.size() <= 120 &&
        request.resource.data.budget is string &&
        request.resource.data.budget.size() <= 80 &&
        request.resource.data.contactNotes is string &&
        request.resource.data.contactNotes.size() <= 1000 &&
        request.resource.data.createdAt is string &&
        request.resource.data.createdAt.size() <= 40 &&
        request.resource.data.status == '受付済';
    }

    // Public users may submit a bounded request, but cannot read or mutate requests.
    match /requests/{requestId} {
      allow create: if validPublicRequest(requestId);
      allow read, update, delete: if isAdmin();
    }

    // Canonical admin settings: public visitors use publicSettings instead.
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Connection Health Check is not part of the public catalog.
    match /test/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
