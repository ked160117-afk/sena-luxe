{
  "name": "sena-luxe",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/200.html')\"",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore --project sena-luxe-rules-test \"node --test tests/firestore.rules.test.js\"",
    "test:rules:prep": "firebase emulators:exec --only firestore --project sena-luxe-prep-rules-test \"node --test tests/firestore.prep.rules.test.js\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.36.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "zod": "^4.6.6"
    },
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    }
  }
}
